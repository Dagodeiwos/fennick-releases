# Cloudflare Web Analytics adds one external script (static.cloudflareinsights.com) that reports page views to
# cloudflareinsights.com. I allow exactly those two hosts; the site has no scripts of its own, so nothing else runs.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
