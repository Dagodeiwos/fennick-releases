# Scripts: my one file, /assets/ambient.js (the marsh sound toggle), plus Cloudflare Web Analytics, one external
# script (static.cloudflareinsights.com) that reports page views to cloudflareinsights.com. No inline scripts or
# handlers. The sound files load from this site, which default-src 'self' already allows, so no media-src is needed.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
